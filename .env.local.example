# ── Site URL (SEO: sitemap, robots, canonical) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rvintel.io

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required for all Supabase features including magic-link auth and data queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Magic-link auth setup ────────────────────────────────────────────────────
# In your Supabase dashboard → Authentication → URL Configuration:
#   Site URL:             https://your-domain.com
#   Redirect URLs (add):  https://your-domain.com/auth/callback
#                         http://localhost:3000/auth/callback  (for local dev)
#
# No additional env vars are required — emailRedirectTo is derived from
# window.location.origin at runtime so it works in both dev and production.

# ── Stripe (subscriptions) ───────────────────────────────────────────────────
# TEST keys (sk_test_/pk_test_) must pair with TEST price IDs (livemode: false).
# LIVE keys (sk_live_/pk_live_) must pair with LIVE price IDs — separate account/products.
# Use price_… IDs from Stripe Dashboard → Product → Pricing. NOT prod_… product IDs.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_SOLO=price_...
STRIPE_PRICE_ID_GROWTH=price_...
STRIPE_PRICE_ID_FLEET=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Live production price IDs (acct_1TfqGnB67ExGpyp5 — copy to Vercel when using sk_live_):
# STRIPE_PRICE_ID_SOLO=price_1TftbrB67ExGpyp5SCj5mQ78    RVIntel One   $9.99/mo
# STRIPE_PRICE_ID_GROWTH=price_1TfqxkB67ExGpyp5XyJNEB9L  RVIntel Growth $19.99/mo
# STRIPE_PRICE_ID_FLEET=price_1TfqxlB67ExGpyp5zk5zjlPs   RVIntel Fleet  $39.99/mo

# ── Admin (waitlist activation) ──────────────────────────────────────────────
ADMIN_SECRET=a-long-random-secret-string

# ── Scraping / cron ──────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-your-key-here
CRON_SECRET=a-long-random-secret-string
